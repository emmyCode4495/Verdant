{
  "expo": {
    "name": "Verdant",
    "slug": "verdant",
    "scheme": "verdant",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#16342A"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-video"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.verdant.app"
    },
    "android": {
      "package": "com.verdant.app",
      "backgroundColor": "#16342A"
    }
  }
}
